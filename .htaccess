DirectoryIndex index.html

# Activer la reecriture d'URL
RewriteEngine On

# 1. URLS LONGUES DESCRIPTIVES
# Locations (vacances.html)
RewriteRule ^location-villas-vacances-senegal-petite-cote$ vacances.html [L,QSA]
RewriteRule ^vacances$ location-villas-vacances-senegal-petite-cote [R=301,L]

# Ventes (ventes.html)
RewriteRule ^achat-immobilier-villas-terrains-senegal$ ventes.html [L,QSA]
RewriteRule ^ventes$ achat-immobilier-villas-terrains-senegal [R=301,L]

# Hotel (hotel.html) - Sans mention JO
RewriteRule ^bien-hotel-dubai-luxe-confort-senegal$ hotel.html [L,QSA]
RewriteRule ^hotel$ bien-hotel-dubai-luxe-confort-senegal [R=301,L]

# Contact (contact.html)
RewriteRule ^contact-baobab-horizon-immobilier-senegal$ contact.html [L,QSA]
RewriteRule ^contact$ contact-baobab-horizon-immobilier-senegal [R=301,L]

# Mentions legales
RewriteRule ^mentions-legales$ mentions-legales.html [L,QSA]

# Politique de confidentialite
RewriteRule ^politique-de-confidentialite$ politique-de-confidentialite.html [L,QSA]

# 2. RETIRER L'EXTENSION .HTML
RewriteCond %{REQUEST_METHOD} GET
RewriteCond %{THE_REQUEST} \s/+(.*?)\.html\s [NC]
RewriteRule ^ %1 [R=301,L,NE]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# 3. RETIRER L'EXTENSION .PHP
RewriteCond %{REQUEST_METHOD} GET
RewriteCond %{THE_REQUEST} \s/+(.*?)\.php\s [NC]
RewriteRule ^ %1 [R=301,L,NE]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]
